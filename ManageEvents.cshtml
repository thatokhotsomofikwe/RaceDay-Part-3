@model List<RaceDay.MVC.Controllers.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
        <div>
            <h1 class="display-5 fw-bold">Manage Events</h1>
            <p class="lead">View and manage your RaceDay events.</p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Error
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are available to display yet.
            You can create your first event using the button above.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.EventType</td>
                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@item.Location</td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Organiser"
                                       asp-action="EditEvent"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="EventParticipants"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-sm btn-outline-info">
                                        Participants
                                    </a>

                                    <a asp-controller="Categories"
                                       asp-action="Index"
                                       asp-route-eventId="@item.EventID"
                                       class="btn btn-sm btn-outline-success">
                                        Manage Categories
                                    </a>

                                    <a asp-controller="Results"
                                       asp-action="Manage"
                                       asp-route-eventId="@item.EventID"
                                       class="btn btn-sm btn-outline-dark">
                                        Manage Results
                                    </a>

                                    <form asp-controller="Organiser"
                                          asp-action="DeleteEvent"
                                          asp-route-id="@item.EventID"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>
</div>