@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    int eventId = ViewBag.EventID ?? 0;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
        <div>
            <h1 class="display-5 fw-bold">Manage Categories</h1>
            <p class="lead">Manage the categories available for this event.</p>
        </div>

        <a asp-controller="Categories"
           asp-action="Create"
           asp-route-eventId="@eventId"
           class="btn btn-primary">
            + Add Category
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories have been added to this event yet.
            Select Add Category to create one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Distance (km)</th>
                        <th>Entry Fee</th>
                        <th>Maximum Participants</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@category.DistanceKm.ToString("0.##")</td>
                            <td>R @category.EntryFee.ToString("0.00")</td>
                            <td>@category.MaxParticipants</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Categories"
                                       asp-action="Edit"
                                       asp-route-id="@category.CategoryID"
                                       asp-route-eventId="@category.EventID"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-controller="Categories"
                                          asp-action="Delete"
                                          asp-route-id="@category.CategoryID"
                                          asp-route-eventId="@category.EventID"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this category?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="ManageEvents"
           class="btn btn-outline-secondary">
            Back to Manage Events
        </a>
    </div>
</div>