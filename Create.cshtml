@model RaceDay.MVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Add Category";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="display-5 fw-bold">Add Category</h1>
        <p class="lead">Enter the category details for your event.</p>
    </div>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-controller="Categories"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="EventID" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CategoryName"
                                   class="form-label">Category Name</label>
                            <input asp-for="CategoryName"
                                   class="form-control"
                                   placeholder="e.g. 10 km Open" />
                            <span asp-validation-for="CategoryName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DistanceKm"
                                   class="form-label">Distance (km)</label>
                            <input asp-for="DistanceKm"
                                   type="number"
                                   step="0.1"
                                   min="0.1"
                                   class="form-control" />
                            <span asp-validation-for="DistanceKm"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EntryFee"
                                   class="form-label">Entry Fee (R)</label>
                            <input asp-for="EntryFee"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />
                            <span asp-validation-for="EntryFee"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MaxParticipants"
                                   class="form-label">Maximum Participants</label>
                            <input asp-for="MaxParticipants"
                                   type="number"
                                   min="1"
                                   class="form-control" />
                            <span asp-validation-for="MaxParticipants"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Save Category
                        </button>

                        <a asp-controller="Categories"
                           asp-action="Index"
                           asp-route-eventId="@Model.EventID"
                           class="btn btn-outline-secondary ms-2">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}